{
  "name": "YouTube Ad Auto-skipper",
  "short_name": "ad skipper",
  "description": "YouTube Ad Skipper is an extension that auto skips ads after YouTube provides a skip ad button. It does not block an ad.",
  "manifest_version": 3,
  "version": "1.0.0",
  "author": "BotBlake",
  "homepage_url": "https://github.com/BotBlake/yt-ad-autoskipper",
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["./youtube.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["./youtube_override.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "Configure Ad Auto Skipper"
  },
  "options_page": "pages/settings.html",
  "permissions": ["storage"],
  "icons": {
    "128": "logo.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "yt-ad-autoskipper@botblake.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
